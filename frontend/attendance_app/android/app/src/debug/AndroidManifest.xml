<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Debug-only overlay. Merged into debug builds and into nothing else.

      Cleartext HTTP is needed here because a local run points at a development
      backend over plain HTTP: api_config.dart otherwise resolves to the Azure
      host, so a local run passes API_BASE_URL=http://<host>:8000 via dart-define.
      Release builds get no cleartext permission at all.

      tools:replace is not required today, since the main manifest no longer sets
      the attribute, but it keeps this overlay authoritative if it is ever
      reintroduced there: two manifests declaring the same application attribute
      is a merge error otherwise.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
