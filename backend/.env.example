# Copy this file to backend/.env and fill in. NEVER commit the real .env; it is
# already gitignored.
#
# Only the variables listed here are read. Anything else in .env is inert, which
# is why two cookie-security knobs that used to appear in this file are gone:
# SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE are switched on automatically
# whenever DJANGO_DEBUG is false, and setting them here did nothing at all.

# --- Required -------------------------------------------------------------
#
# There is no fallback. Django refuses to start without this, deliberately: a
# default would silently become the production signing key for sessions and
# password-reset links, and in a public repository that value is readable.
#
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-with-the-command-above

# --- Database -------------------------------------------------------------
#
# Omit entirely to use SQLite at backend/db.sqlite3, which is what the test
# suite does. The docker-compose stack supplies Postgres.
DATABASE_URL=postgres://postgres:postgres@db:5432/attend_db

# --- Host and origin policy ----------------------------------------------
#
# Defaults to False. Never true on anything publicly reachable.
DJANGO_DEBUG=True

# Comma-separated. Defaults to localhost only, so a real deployment must set
# its own hostname or every request 400s. The "*" wildcard is not accepted:
# with it present Django disables Host-header checking entirely.
ALLOWED_HOSTS=localhost,127.0.0.1

# Browsers only. Django serves the Flutter web build itself, so the
# first-party client is same-origin and needs none of this.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Defaults to False, and should stay that way. Together with
# CORS_ALLOW_CREDENTIALS - which this project needs - true here lets any origin
# make credentialed requests.
CORS_ALLOW_ALL_ORIGINS=False

# Needed only when the app is served from a different origin than the API.
CSRF_TRUSTED_ORIGINS=

# --- Presence layer -------------------------------------------------------
#
# Unpadded base64url Ed25519 seed, 32 bytes. Generate one with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# Unique per deployment. Rotation: put the new key here, move the old one to
# PRESENCE_RETIRED_SIGNING_KEYS (comma-separated, verify-only) until every
# signature it made has expired, then drop it. Nothing is re-signed.
PRESENCE_SIGNING_KEY=
PRESENCE_RETIRED_SIGNING_KEYS=

# --- Android App Links ----------------------------------------------------
#
# Comma-separated uppercase colon-separated SHA-256 fingerprints of the signing
# certificate. With Play App Signing this is the fingerprint Play reports, not
# the one from your local upload keystore. Empty publishes an empty list, which
# is an honest "not configured" rather than a claim about a key nobody holds.
ANDROID_APP_PACKAGE=com.campusguard.attendance
ANDROID_CERT_FINGERPRINTS=

# --- Seeding (development only) -------------------------------------------
#
# Seeding creates known-credential accounts including a superuser. It is off
# unless invited, refuses to run when DJANGO_DEBUG is false unless
# SEED_ALLOW_PRODUCTION=1 insists, and refuses without an explicit password.
SEED_ON_START=0
SEED_PASSWORD=
